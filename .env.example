# Set these in the environment before launching Pi or an MCP-enabled harness.
# This file is documentation only and is not auto-loaded.
# Use one credential family. If both are present, set DATABRICKS_AUTH to pat or oauth-m2m.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_AUTH=
# Personal access token:
DATABRICKS_TOKEN=
# OAuth machine-to-machine service principal (client credentials):
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# Optional. Defaults to all-apis. Prefer a scoped secret such as sql,jobs,unity-catalog.
DATABRICKS_OAUTH_SCOPE=
DATABRICKS_WAREHOUSE_ID=
# Optional defaults for SQL name resolution; these do NOT enforce isolation.
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=

# Local dbt artifacts. The server reads run_results.json and manifest.json. It does not run dbt.
DBT_ARTIFACTS_DIR=
DBT_PROJECT_DIR=
DBT_LOG_PATH=

# Airflow stable REST API. Use v1 for Airflow 2 and v2 for Airflow 3. Auth mode is bearer or basic.
AIRFLOW_BASE_URL=https://airflow-sandbox.example.com
AIRFLOW_API_VERSION=v2
AIRFLOW_AUTH_MODE=bearer
AIRFLOW_TOKEN=
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
AIRFLOW_ENVIRONMENT=sandbox
