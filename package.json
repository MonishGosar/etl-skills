{
  "name": "etl-agent-tools",
  "version": "0.2.0-beta.1",
  "description": "Portable ETL inspection tools and guarded Databricks workflows for coding agents",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MonishGosar/etl-skills.git"
  },
  "homepage": "https://github.com/MonishGosar/etl-skills#readme",
  "bugs": "https://github.com/MonishGosar/etl-skills/issues",
  "bin": {
    "etl-agent-tools": "./dist/mcp.js",
    "etl-agent-tools-mcp": "./dist/mcp.js",
    "etl-agent-tools-install-skills": "./dist/install-skills.js"
  },
  "keywords": [
    "pi-package",
    "databricks",
    "etl",
    "mcp",
    "agent-skills"
  ],
  "files": [
    "extensions",
    "src",
    "dist",
    "config",
    "skills",
    "README.md",
    "CONTEXT.md",
    "RELEASE_PLAN.md",
    "FUTURE_WORK.md",
    "ENVIRONMENT_SETUP.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE",
    ".claude-plugin",
    ".mcp.json"
  ],
  "pi": {
    "extensions": [
      "./extensions/databricks.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsx --test tests/*.test.ts",
    "verify:packed": "node scripts/verify-packed-install.mjs",
    "verify": "npm run typecheck && npm test && npm run verify:packed"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "typebox": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.2.0"
  }
}
